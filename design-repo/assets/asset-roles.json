{
  "id": "assets.roles",
  "version": "3.0.0",
  "note": "Closed assetRole vocabulary DERIVED FROM REAL USAGE SITES (grep of src= / Placeholder / LogoPlaceholder in src/). Every media field in schema/pagespec.schema.json is an object whose assetRole comes from this enum, restricted per field; no section exposes a bare image/src string. Subpage sections (2.0.0) reuse the same roles; the only addition is stock.photo for the licensed stock stand-ins in public/stock/. 3.0.0 adds the closed availability enum (clone-only | generation-safe | blocked-for-generation), generationSafeSubstitutes and generatedModeGuidance on every role, and nine generation-safe roles (asset.userSupplied, illustration.generated, screenshot.placeholder, person.fictional, logo.placeholderCompany, badge.placeholder, brand.placeholderMark, url.placeholder, copy.original) wired into every media slot of the schema, the contracts and the allowlist.",
  "generationPolicyEnum": [
    "may-generate-new",
    "may-reuse-licensed",
    "must-reuse-exact",
    "must-not-reuse",
    "must-not-fabricate"
  ],
  "generationPolicyMeaning": {
    "may-generate-new": "A generator may render the neutral placeholder or supply a NEWLY generated, original asset under generated/ (assetRef).",
    "must-reuse-exact": "Only the existing in-repo component may be used (e.g. the Wordmark). Not settable from a PageSpec.",
    "must-not-reuse": "HARD BAN. Real third-party or proprietary imagery. The generator must not emit the file, a copy, a crop, a trace or an imitation, and must not reference its path. The PageSpec field carries a role and optional geometry-only label; it renders as a neutral placeholder. No assetRef is accepted (ASSET_REF_FORBIDDEN_FOR_PROTECTED_ROLE).",
    "must-not-fabricate": "HARD BAN on reuse AND on synthesis: covers real ratings, awards and real people's likeness, where even a look-alike makes a false claim. Renders as a neutral placeholder; no assetRef accepted.",
    "may-reuse-licensed": "The role's files are freely licensed stand-ins (Unsplash License via Picsum, credited in public/stock/CREDITS.md). A generator may reference one of them as assetRef 'stock/<id>.jpg', replace it with another freely licensed image, or supply a newly generated original under generated/. Never use it for a person slot presented as a named testimonial author or customer (that stays photo.person, must-not-fabricate)."
  },
  "pinnedPolicies": {
    "note": "These roles are PINNED to an exact policy value, not merely constrained to the enum. extraction/verify_all.py::check_pinned_asset_policies fails the run if any drifts -- including to a DIFFERENT-BUT-VALID enum member such as may-generate-new -- and both verify_all.py --prove-drift and schema/tests/adversarial_test.py prove that exact mutation is caught. Membership-in-a-closed-set is a weaker claim than 'this role must hold this value'.",
    "logo.customer": "must-not-reuse",
    "logo.aiVendor": "must-not-reuse",
    "badge.review": "must-not-fabricate",
    "badge.award": "must-not-fabricate",
    "photo.person": "must-not-fabricate",
    "photo.event": "must-not-reuse",
    "photo.brand": "must-not-reuse",
    "product.screenshot": "must-not-reuse",
    "product.video": "must-not-reuse",
    "stock.photo": "may-reuse-licensed"
  },
  "sourceIsARealCompany": {
    "value": true,
    "statement": "The cloned source is thrivelearning.com, a real, live company's site. The clone deliberately uses ORIGINAL placeholder copy (brand 'Nimbus', AI assistant 'Nova'). Nothing in this design-repo licenses reuse of the original's text, marks or imagery.",
    "localReferenceImages": "The source project's public/assets/ holds 56 images the user copied from their own saved page of the original site for local reference: real customer logos, real product screenshots, a real named person's photo, review/award badges and AI-vendor logos. NONE of them is copied into design-repo/, and none may appear in generated output. public/stock/ holds separately licensed Unsplash stock (stock.photo); those are not reference copies of the original.",
