  "reducedMotion": {
    "sourceImplements": false,
    "statement": "Neither the original site nor this clone has any prefers-reduced-motion handling (grep of src/, index.html and tailwind.config.js finds none). The PageSpec schema nevertheless REQUIRES a reducedMotionFallback on every node so generated pages get one; each fallback below is a generation requirement, not a description of the source."
  },
  "easing": {
    "outQuart": "cubic-bezier(0.165, 0.84, 0.44, 1) (CSS fallback; linear() quartic where supported) -- Webflow IX2 outQuart",
    "inOutQuart": "cubic-bezier(0.77, 0, 0.175, 1) (CSS fallback; linear() quartic where supported)",
    "power3.out": "GSAP power3.out (= IX2 outQuart, quartic)",
    "power4.inOut": "GSAP power4.inOut (= IX3 ease index 12)",
    "ease": "CSS ease",
    "linear": "linear (bullet progress fill)",
    "none": "GSAP ease none (scrubbed timeline)",
    "tailwind-default": "Tailwind's default transition timing cubic-bezier(0.4, 0, 0.2, 1), applied where the clone sets a duration class but no ease class"
  },
  "easingMeasuredFrom": "tailwind.config.js:89-91",
  "reducedMotionFallbacks": {
    "none": "Nothing to reduce.",
    "instant-toggle": "Switch open/closed or active state immediately, without the transition.",
    "instant-final-state": "Render the end state immediately (fully visible, unscaled, final colour). No scroll scrub, no load reveal.",
    "instant-slide-change": "Change slides without the 800ms transform transition; manual controls keep working.",
    "autoplay-off-instant-slide-change": "Do not autoplay; render paused with the play control available; slide changes are instant.",
    "static-first-frame": "Do not animate the loop: render the first frame (first row / un-translated track) statically."
  },
