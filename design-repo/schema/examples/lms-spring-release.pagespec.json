    {
      "section": "product.release-block",
      "content": {
        "theme": "light",
        "heading": {
          "text": "Nova. Now on autopilot.",
          "boldPhrases": [
            "autopilot."
          ],
          "linkPhrases": []
        },
        "body": "Five new AI roles that plan, build, coach, review and report across your learning, working quietly alongside your team so admins can focus on the people instead of the busywork.",
        "ctaLabel": "Meet Nova",
        "media": {
          "kind": "strip",
          "visual": {
            "assetRole": "placeholder.neutral",
            "placeholderLabel": "Looping video"
          }
        },
        "items": [
          {
            "title": "Review",
            "body": "Nova reviews completion trends across every team and flags the courses that need attention before deadlines start to slip."
          },
          {
            "title": "Build",
            "body": "Nova turns policies, notes and slide decks into short lessons with quizzes, ready for an admin to check and publish."
          },
          {
            "title": "Plan",
            "body": "Nova suggests the next step for each person based on their role, goals and the skills their team is building right now."
          },
          {
            "title": "Guide",
            "body": "Nova follows up after each course with friendly nudges and short, handy refreshers so all the learning really sticks."
          }
        ],
        "quote": {
          "text": "“We treat Nova like a brand new colleague on the team. It takes on the repetitive work that used to fill our week, spots gaps before we do and gives our people answers in seconds. That frees our small team to spend its time on coaching, culture and the projects that actually move the whole business forward.”",
          "name": "Jordan Ellis",
          "role": "Head of Digital Learning, Northwind",
          "avatar": {
            "assetRole": "placeholder.neutral"
          }
        }
      },
      "motion": {
        "pattern": "none",
        "reducedMotionFallback": "none"
      }
    },
