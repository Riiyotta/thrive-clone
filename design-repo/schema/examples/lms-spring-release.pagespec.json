      "section": "hero.wow-content",
      "content": {
        "variant": "spring-release",
        "tag": "NEW",
        "title": "The Nimbus Fall Release",
        "paragraph": "Our newest features bring helpful AI into your daily workflows, taking on the manual work so your people can focus on what matters most: each other.",
        "buttonLabel": "See it all in action",
        "visual": {
          "assetRole": "placeholder.neutral",
          "placeholderLabel": "Release overview"
        }
      },
      "motion": {
        "pattern": "none",
        "reducedMotionFallback": "none"
      }
