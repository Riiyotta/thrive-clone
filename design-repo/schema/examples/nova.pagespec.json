    {
      "section": "product.autotabs-group",
      "content": {
        "variant": "platform",
        "heading": "The best learning tool doesn't just track learning. It connects it all",
        "paragraph": "Search across every connected system, run Nimbus from your favourite AI assistants, surface the hidden gems buried in a decade of old course files, and build your own learning tools in minutes. All within the limits you choose.",
        "tabs": [
          {
            "tab": "Connected search",
            "title": "One search for every answer.",
            "text": "Whether it lives in your documents, chat tools, intranet or course library, Nimbus finds the right answer for each person and shows them exactly where it came from, in just a few seconds, every single time.",
            "media": {
              "assetRole": "placeholder.neutral",
              "placeholderLabel": "Product screenshot 16:9"
            }
          },
          {
            "tab": "Course search",
            "title": "Search inside every course you own.",
            "text": "Nimbus reads the content inside uploaded course packages, so learners can jump straight to the exact lesson, slide or video moment that answers their question, right when they need it most.",
            "media": {
              "assetRole": "placeholder.neutral",
              "placeholderLabel": "Product screenshot 16:9"
            }
          },
          {
            "tab": "Assistant",
            "title": "Run Nimbus from the AI tools you already use every day.",
            "text": "Create spaces, assign courses and pull reports from your favourite AI assistant, with the very same permissions, safeguards and full audit trail as the platform itself, every time.",
            "media": {
              "assetRole": "placeholder.neutral",
              "placeholderLabel": "Product screenshot 16:9"
            }
          },
          {
            "tab": "Build your own",
            "title": "Build the learning tools you imagine.",
            "text": "Describe a quiz, a checklist or a mini app in plain words and Nimbus builds it for you in moments, ready to share with any team, site or region you choose in a single click, with no code needed.",
            "media": {
              "assetRole": "placeholder.neutral",
              "placeholderLabel": "Product screenshot 16:9"
            }
          }
        ],
        "quote": {
          "quote": "\"Everyone in L&D talks about AI right now. Fewer vendors help you see what it could actually look like inside the systems you already have. This is what that looks like. The same platform you already pay for, suddenly capable of far more than we expected.\"",
          "name": "Jordan Ellis",
          "role": "Senior Talent Development Manager,",
          "org": "Northwind"
        }
      },
      "motion": {
        "pattern": "carousel.dragLoop",
        "reducedMotionFallback": "instant-slide-change"
      }
