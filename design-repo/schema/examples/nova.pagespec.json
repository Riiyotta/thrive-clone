    {
      "section": "product.split-tabs",
      "content": {
        "variant": "base",
        "heading": {
          "text": "A Nova for every team",
          "linkPhrases": [],
          "boldPhrases": [
            "every team"
          ]
        },
        "intro": "One assistant, solving every team’s challenges.",
        "buttonLabel": "Book a demo",
        "tabs": [
          {
            "tab": "Customer service",
            "text": "Nova pulls the right answer from your help centre, policies and past tickets, so support teams reply faster and every customer hears the same accurate message, whichever channel they use or whoever happens to pick up the conversation that day.",
            "media": {
              "assetRole": "placeholder.neutral",
              "placeholderLabel": "Product video 16:9"
            }
          },
          {
            "tab": "Sales teams",
            "text": "Nova coaches reps before every call with product facts, objection handling and the latest pricing, then suggests short refreshers based on how each conversation actually went.",
            "media": {
              "assetRole": "placeholder.neutral",
              "placeholderLabel": "Product video 16:9"
            }
          },
          {
            "tab": "People teams",
            "text": "Nova answers policy questions, drafts onboarding plans and builds short courses from your documents, so people teams spend less time on admin and more time with their people.",
            "media": {
              "assetRole": "placeholder.neutral",
              "placeholderLabel": "Product video 16:9"
            }
          },
          {
            "tab": "Frontline teams",
            "text": "On any shift and any device, Nova gives frontline staff quick how-to answers and bite-sized refreshers in their own language, right when they need them on the floor.",
            "media": {
              "assetRole": "placeholder.neutral",
              "placeholderLabel": "Product video 16:9"
            }
          },
          {
            "tab": "Compliance & risk",
            "text": "Nova keeps policies current, flags gaps in training and answers compliance questions with links to the source, so audits feel routine instead of stressful.",
            "media": {
              "assetRole": "placeholder.neutral",
              "placeholderLabel": "Product video 16:9"
            }
          }
        ]
      },
      "motion": {
        "pattern": "tabs.crossFade",
        "reducedMotionFallback": "instant-toggle"
      }
    },
    {
      "section": "product.comparison-table",
      "content": {
        "variant": "vendor",
        "title": {
          "text": "How to compare learning platforms",
          "boldPhrases": [
            "learning platforms"
          ],
          "linkPhrases": []
        },
        "intro": "Bring these questions into every vendor conversation. Here is what good looks like, and how Nimbus measures up.",
        "rows": [
          {
            "area": "Security and compliance",
            "ask": "Which independent certifications do you hold, and can you share proof early in the buying process?",
            "good": "Current, independently checked security and quality certifications",
            "evidence": {
              "text": "Independent security certifications with a public trust centre for every customer",
              "linkPhrases": [
                "Independent security certifications"
              ]
            }
          },
          {
            "area": "Global reach",
            "ask": "Can the platform support our languages, regions, brands and separate business units?",
            "good": "Translation, multi-region hosting and separately branded spaces",
            "evidence": {
              "text": "40+ languages, regional hosting and multi-brand setup as standard for all",
              "linkPhrases": [
                "40+ languages",
                "multi-brand setup"
              ]
            }
          },
          {
            "area": "AI capability",
            "ask": "Does the AI only answer questions, or can it also create, coach and take action?",
            "good": "Governed AI that supports learners, authors and admins in context",
            "evidence": {
              "text": "Nova supports insight, authoring, coaching, admin and knowledge, with assistant access from the AI tools your teams already use every day",
              "linkPhrases": [
                "Nova",
                "assistant access"
              ]
            }
          },
          {
            "area": "Integrations",
            "ask": "Which HR, chat and identity systems do you connect with today?",
            "good": "Proven integrations with the tools your teams already use daily",
            "evidence": {
              "text": "Integrations include HR, chat, CRM, identity and productivity tools, with more added each quarter",
              "linkPhrases": [
                "Integrations"
              ]
            }
          },
          {
            "area": "Support after launch",
            "ask": "What support is included once we are live, and how fast do you respond?",
            "good": "Clear ongoing support, enablement and a named point of contact",
            "evidence": {
              "text": "Round-the-clock support, a named success manager and a help centre with guides",
              "linkPhrases": [
                "Round-the-clock support",
                "help centre"
              ]
            }
          },
          {
            "area": "Product momentum",
            "ask": "How often do you release meaningful new features for customers?",
            "good": "A visible and reliable release rhythm",
            "evidence": {
              "text": "40 new features shipped across the last two quarters",
              "linkPhrases": [
                "40 new features shipped"
              ]
            }
          },
          {
            "area": "Migration",
            "ask": "What happens to our users, content, learning records and integrations when we switch platforms?",
            "good": "A documented migration plan with testing and continuity checks",
            "evidence": {
              "text": "Guided migration from your current platform, fully tested before launch day",
              "linkPhrases": [
                "Guided migration"
              ]
            }
          }
        ]
      },
      "motion": {
        "pattern": "none",
        "reducedMotionFallback": "none"
      }
