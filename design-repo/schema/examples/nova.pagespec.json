    {
      "section": "product.assistant-feature-tabs",
      "content": {
        "reversed": false,
        "heading": "Made for the people who run learning",
        "intro": "Nova reviews results, drafts courses, answers questions and keeps learners moving, so your team spends less time on admin and more time on the work that matters. It plugs into the tools you already use and gets smarter the more your people lean on it every week.",
        "items": [
          {
            "title": "Skip the reports and get straight answers",
            "body": "Nova reads your dashboards and surfaces what matters on compliance, take-up and results. Spot the gaps in seconds, not spreadsheets.",
            "media": {
              "assetRole": "placeholder.neutral",
              "placeholderLabel": "Nova video 1"
            }
          },
          {
            "title": "Polished courses ready in minutes",
            "body": "Type a prompt or upload a file and Nova turns it into a finished course, quiz or lesson. No blank page, no starting over, just an extra maker on the team.",
            "media": {
              "assetRole": "placeholder.neutral",
              "placeholderLabel": "Nova video 2"
            }
          },
          {
            "title": "Prompts that can handle a thousand admin jobs",
            "body": "Enrol a whole site, chase every late learner and tidy years of old content, all from one sentence to Nova, so your team never has to open a spreadsheet again.",
            "media": {
              "assetRole": "placeholder.neutral",
              "placeholderLabel": "Nova video 3"
            }
          }
        ]
      },
      "motion": {
        "pattern": "tabs.crossFade",
        "reducedMotionFallback": "instant-toggle"
      }
    },
