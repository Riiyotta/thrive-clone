    {
      "section": "product.layout03-tabs",
      "content": {
        "variant": "image",
        "heading": {
          "text": "The AI agent corporate L&D teams have wanted",
          "linkPhrases": [],
          "boldPhrases": []
        },
        "paragraph": "You do not need a team of specialists to get more from learning. Nova takes on the analysis, the course building and the routine admin, so your people can focus on coaching, culture and the work that moves the business.",
        "buttonLabel": "Meet Nova →",
        "tabs": [
          {
            "tab": "Analyst",
            "text": "Nova quickly spots compliance gaps, engagement dips and skills shortfalls across every team the moment they appear, then explains what changed and suggests what to do next.",
            "media": {
              "assetRole": "placeholder.neutral",
              "placeholderLabel": "Product screenshot"
            }
          },
          {
            "tab": "Creator",
            "text": "Turn policies, slide decks and rough notes into polished, interactive courses in minutes, complete with quizzes, summaries and translations ready for every team in the business.",
            "media": {
              "assetRole": "placeholder.neutral",
              "placeholderLabel": "Product screenshot"
            }
          },
          {
            "tab": "Coach",
            "text": "Nova checks in after each lesson, asks what landed and suggests one small next step, so new habits keep building long after the session ends for everyone.",
            "media": {
              "assetRole": "placeholder.neutral",
              "placeholderLabel": "Product screenshot"
            }
          },
          {
            "tab": "Admin",
            "text": "Let Nova build audiences, schedule reminders, tidy enrolments and prepare reports in the background, so your team can spend far more time with people and far less time on routine setup tasks.",
            "media": {
              "assetRole": "placeholder.neutral",
              "placeholderLabel": "Product screenshot"
            }
          },
          {
            "tab": "Assistant",
            "text": "Anyone can ask Nova a question in the flow of work and get a clear answer from your own content, with links to dig deeper.",
            "media": {
              "assetRole": "placeholder.neutral",
              "placeholderLabel": "Product screenshot"
            }
          }
        ],
        "paneMedia": {
          "assetRole": "placeholder.neutral",
          "placeholderLabel": "Product screenshot"
