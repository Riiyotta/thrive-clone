      "section": "product.two-col-features",
      "content": {
        "preset": "company",
        "rows": [
          {
            "title": "Why teams pick Nimbus",
            "text": {
              "text": "Most learning platforms track completions. Nimbus goes further. Learning, skills and knowledge live in one AI-powered place that people genuinely want to use. That's why over 400 organisations across 50 countries trust it to drive performance that actually shows up in their business results. There’s never been a learning platform quite like it.",
              "linkPhrases": []
            },
            "quote": "“Nimbus has completely changed the way we run learning and development here. It’s made everything so much more engaging, far more accessible, and so much more effective with everything we roll out.”",
            "name": "Jordan Ellis",
            "role": {
              "text": "L&D Manager, Northwind Brewery",
              "linkPhrases": []
            },
            "avatar": {
              "assetRole": "placeholder.neutral"
            },
            "image": {
              "assetRole": "placeholder.neutral",
              "placeholderLabel": "Team photo"
            }
          },
          {
            "title": "Customers first. Every day.",
            "text": {
              "text": "We don't vanish after go-live. Every Nimbus customer gets a dedicated team from day one, with launch support, strategy, training and help built around your goals, not ours. It's why our customers stay, and why they keep winning awards with us.",
              "linkPhrases": [
                "launch support"
              ]
            },
            "quote": "\"Would I recommend Nimbus to other organisations? A resounding yes. The partnership your organisation will build with the Nimbus team is like no other, and I truly, truly endorse it.\"",
            "name": "Sam Rivera",
            "role": {
              "text": "Global Head of Learning & Development, Kite",
              "linkPhrases": []
            },
            "avatar": {
              "assetRole": "placeholder.neutral"
            },
            "image": {
              "assetRole": "placeholder.neutral",
              "placeholderLabel": "Product visual"
            }
          }
        ]
