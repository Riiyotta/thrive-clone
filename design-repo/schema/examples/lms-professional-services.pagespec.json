    {
      "section": "product.feature-rows-legacy",
      "content": {
        "variant": "services",
        "theme": "green",
        "rows": [
          {
            "title": "Hands-on Admin Cover",
            "body": "Whether it is for one day a week or every day of the year, our experienced admins can run the routine work on your platform for you, from enrolments and reporting to content uploads, so your own team has far more time for the bigger projects that really need their attention most.",
            "ctaLabel": "Find out more",
            "media": {
              "assetRole": "placeholder.neutral",
              "placeholderLabel": "Feature image 3:2"
            }
          },
          {
            "title": "Your Own Support Lead",
            "body": "Whether it is daily help with tricky questions or a regular check-in with your leaders, a named specialist who knows your setup inside out is always on hand to keep things running smoothly, answer questions quickly and help you get much more value from every single feature you already use today.",
            "ctaLabel": "Find out more",
            "media": {
              "assetRole": "placeholder.neutral",
              "placeholderLabel": "Feature image 3:2"
            }
          }
        ]
      },
      "motion": {
        "pattern": "none",
        "reducedMotionFallback": "none"
