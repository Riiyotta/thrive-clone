              "text": "We help you plan the internal launch with comms, champions and quick wins that turn a new platform into a daily habit across every site and team.",
              "linkPhrases": [],
              "boldPhrases": [
                "internal launch"
              ]
            },
            "media": {
              "assetRole": "placeholder.neutral",
              "placeholderLabel": "Participation photo"
            }
