    {
      "section": "product.grid-cards-legacy",
      "content": {
        "variant": "services-extra",
        "theme": "green",
        "heading": "Additional Short-Term Support",
        "body": "When you need a little more help, our specialists can step in for a short project, from a fresh setup review to a full data migration, so your team keeps moving forward without the cost of extra hires or long, fixed contracts with outside agencies.",
        "rows": [
          {
            "cards": [
              {
                "title": "Setup review",
                "body": "Refresh your configuration with a guided session that tidies audiences, automations and reports, so your platform keeps pace with how your business works today."
              },
              {
                "title": "Launch planning",
                "body": "Plan a brand new programme with our specialist team, from the very first brief and timeline through to the launch comms that get your learners genuinely excited to take part from day one."
              },
              {
                "title": "Content audit",
                "body": "Find out which courses earn their place, which need a refresh and where the gaps remain, with a clear and practical plan to improve your whole library."
              }
            ]
          },
          {
            "cards": [
              {
                "title": "Data review",
                "body": "Get a clear view of your learning data with a focused review that turns raw numbers into simple, useful insights your leaders can act on."
              },
              {
                "title": "Switching identity or platforms",
                "body": "Changing systems does not need to slow anyone down. We plan and run the whole move with you so every learner keeps their history safe and sound."
              }
            ]
          }
        ]
      },
      "motion": {
        "pattern": "none",
        "reducedMotionFallback": "none"
      }
