    {
      "section": "story.header-image-legacy",
      "content": {
        "heading": "Nimbus Professional Support",
        "intro": "Nimbus gives you a dedicated team for every stage of your rollout, from planning and data moves to launch, adoption and the long run. Our specialists bring years of experience across many sectors, so you get a partner who helps you hit your goals and keeps the momentum going well after go-live.",
        "badges": {
          "assetRole": "placeholder.neutral",
          "placeholderLabel": "Badge",
          "slotCount": 4
        },
        "media": {
          "assetRole": "placeholder.neutral",
          "placeholderLabel": "Team photo"
        }
      },
      "motion": {
        "pattern": "none",
        "reducedMotionFallback": "none"
      }
    },
    {
      "section": "story.grid-split-legacy",
      "content": {
        "variant": "testimonial",
        "theme": "green",
        "heading": "Everything included with your Expert Services",
        "body": "Our Expert Services keep your platform running at its very best.",
        "quote": "\"The planning, support and guidance from the whole team were outstanding. They took real time to understand our goals and helped us shape a platform our people genuinely enjoy using every single working day.\"",
        "avatar": {
          "assetRole": "placeholder.neutral"
        },
        "name": "Jordan Ellis",
        "role": "Learning Experience Platform Manager,",
        "org": "Customer one"
      },
      "motion": {
        "pattern": "none",
        "reducedMotionFallback": "none"
      }
