            "label": "Transfers",
            "title": "Change platforms without losing a thing",
            "paragraph": {
              "text": "Coming from another learning system? Our platform move team brings over your users, history and content, checks every record and keeps your teams learning through the switch.",
              "linkPhrases": [],
              "boldPhrases": [
                "platform move"
              ]
            },
            "media": {
              "assetRole": "placeholder.neutral",
              "placeholderLabel": "Transfers photo"
