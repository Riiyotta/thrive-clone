            "label": "Support and Guidance",
            "title": "Support that knows your setup inside out",
            "paragraph": {
              "text": "A named success partner checks in regularly, answers questions fast and brings ideas from teams like yours so the platform keeps getting better.",
              "linkPhrases": [],
              "boldPhrases": [
                "success partner"
              ]
            },
            "media": {
              "assetRole": "placeholder.neutral",
              "placeholderLabel": "Support and Guidance photo"
            }
          },
          {
            "label": "Outcomes",
            "title": "Show the difference learning is making",
            "paragraph": {
              "text": "We set up clear reports that link learning to the numbers your leaders care about, then review them with you every quarter and plan what comes next.",
              "linkPhrases": [],
              "boldPhrases": [
                "clear reports"
              ]
            },
