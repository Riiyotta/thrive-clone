      "section": "hero.content-overview",
      "content": {
        "brandLockup": "nimbus content",
        "title": "Learning content from people who truly understand your teams",
        "text": "Thousands of ready-made learning resources that people actually enjoy, ready to launch on your platform today or alongside the learning tools you already use.",
        "buttonLabel": "Take the content tour",
        "avatars": {
          "assetRole": "placeholder.neutral",
          "slotCount": 3
        },
        "social": "Loved by 500+ teams",
        "logosCaption": "The content library trusted by teams who love learning",
        "logos": {
          "assetRole": "placeholder.neutral",
          "placeholderLabel": "Logo 1",
          "slotCount": 6
        },
        "feature": {
          "heading": "Why learners love our content",
          "text": {
            "text": "Nimbus content is a learning library built for real working lives, ready to launch on whatever platform you use.\n\nPick from core topics covering leadership, wellbeing, communication and essential workplace skills, or add sector-specific suites built for industries such as retail, hospitality, the public sector and financial services teams everywhere.\n\nEvery piece is short, practical and easy to share, so people can learn in the moment and keep on coming back for more and more.\n\nFresh resources arrive every single month, so the library stays current without extra effort.",
            "linkPhrases": [
              "core topics",
              "sector-specific suites"
            ]
          },
          "quote": "“If you are looking for content that people genuinely enjoy and keep coming back to, this is it. Our teams use it every single week, without nudging.”",
          "name": "Sam Rivers",
          "role": "Learning and Development manager, Northwind",
          "avatar": {
            "assetRole": "placeholder.neutral"
          },
          "image": {
            "assetRole": "placeholder.neutral",
            "placeholderLabel": "Content hub"
          },
          "buttonLabel": "Take the content tour"
        }
