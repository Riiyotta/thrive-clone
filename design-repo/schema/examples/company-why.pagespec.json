    {
      "section": "product.why-assistant-tabs",
      "content": {
        "heading": {
          "text": "The friendly assistant your team keeps asking for",
          "linkPhrases": [],
          "boldPhrases": [
            "asking for"
          ]
        },
        "intro": "Flexible and built around how your people already work, Nova answers questions, finds the right resource and nudges every learner forward, so managers spend less time chasing updates and teams spend more time learning together.",
        "headerButtonLabel": "Meet Nova →",
        "slides": [
          {
            "tab": "Guide",
            "highlight": "Coaching that really grows people.",
            "subdued": "Guidance in the flow of work, with prompts, check-ins and honest feedback that adapt to each person, so growth keeps moving even when managers are busy with everything else on their plate this week.",
            "media": {
              "assetRole": "placeholder.neutral",
              "placeholderLabel": "Product video 1:1"
            }
          },
          {
            "tab": "Builder",
            "highlight": "Great content, ready in minutes.",
            "subdued": "An extra designer on the team, turning rough notes, long documents and half-formed ideas into polished learning that people actually want to finish this week.",
            "media": {
              "assetRole": "placeholder.neutral",
              "placeholderLabel": "Product video 1:1"
            }
          },
          {
            "tab": "Analyst",
            "highlight": "Skip the dashboards and just ask.",
            "subdued": "Nova spots gaps, trends and risks across all of your learning data, then explains what it found in plain words that anyone on the team can act on right away.",
            "media": {
              "assetRole": "placeholder.neutral",
              "placeholderLabel": "Product video 1:1"
            }
          },
          {
            "tab": "Admin",
            "highlight": "Housekeeping that quietly happens in the background.",
            "subdued": "Tidy old content, fix broken links and keep every pathway current, so your platform stays fresh without hours of manual clean-up each month, and all of your teams always see what is new.",
            "media": {
              "assetRole": "placeholder.neutral",
              "placeholderLabel": "Product video 1:1"
            }
          },
          {
            "tab": "Assistant",
            "highlight": "One place for every answer.",
            "subdued": "Nova searches all your courses, documents, people and conversations at once, then gives one clear answer with links to every source, so nobody has to dig through old folders or wait around.",
            "media": {
              "assetRole": "placeholder.neutral",
              "placeholderLabel": "Product video 1:1"
            }
          }
        ],
        "splitHeading": "The next era of learning",
        "quote": {
          "quote": "“We needed a platform that could grow with us and keep our people engaged from the very first day. Nimbus gave us all of that and more, with a team that listens closely and a product that keeps on improving every single month for all of our people.”",
