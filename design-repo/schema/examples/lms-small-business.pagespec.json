    {
      "section": "product.assistant-tabs",
      "content": {
        "variant": "image-slides",
        "header": {
          "eyebrow": "Included in every plan",
          "heading": "The features that set Nimbus apart",
          "headingEmphasis": "apart",
          "intro": {
            "text": "Most small teams are stuck with clunky older platforms built for huge companies, with long setup projects and screens nobody enjoys using. Nimbus gives you the same power in a package sized for you, with everything ready on day one, nothing to install and help whenever you need it.",
            "linkPhrases": [
              "older platforms"
            ],
            "boldPhrases": []
          }
        },
        "tabs": [
          {
            "tab": "The hub",
            "highlight": "Bring every one of your tools together.",
            "copy": "No more hopping between apps for courses, files and team updates. Everything your people need sits in one simple home that is easy to set up, easy to run and easy for everyone on the team to love.",
            "ctaLabel": "Explore the hub",
            "visual": {
              "assetRole": "placeholder.neutral",
              "placeholderLabel": "Product UI 16:9"
            }
          },
          {
            "tab": "Mentoring",
            "highlight": "Mentoring that fits a small team.",
            "copy": "Pair new starters with experienced colleagues in a few clicks. Set goals, book check-ins and track progress in one simple home that is easy to set up, easy to run and easy for everyone to love.",
            "ctaLabel": "Explore mentoring",
            "visual": {
              "assetRole": "placeholder.neutral",
              "placeholderLabel": "Product UI 16:9"
            }
          },
          {
            "tab": "Spaces",
            "highlight": "Spaces where your people share ideas.",
            "copy": "No more hopping between different apps for courses, files and team updates. Everything your people need sits in one simple home that is easy to set up, easy to run and easy for everyone to love, with room for every team to share wins, swap tips and ask questions.",
            "ctaLabel": "Explore spaces",
            "visual": {
              "assetRole": "placeholder.neutral",
              "placeholderLabel": "Product UI 16:9"
            }
          }
        ]
      },
      "motion": {
        "pattern": "carousel.dragLoop",
        "reducedMotionFallback": "instant-slide-change"
      }
    },
    {
      "section": "product.layout03-tabs",
      "content": {
        "variant": "image",
        "heading": {
          "text": "The AI agent corporate L&D teams have wanted",
          "linkPhrases": [],
          "boldPhrases": []
        },
        "paragraph": "You do not need a team of specialists to get more from learning. Nova takes on the analysis, the course building and the routine admin, so your people can focus on coaching, culture and the work that moves the business.",
        "buttonLabel": "Meet Nova →",
        "tabs": [
          {
            "tab": "Analyst",
            "text": "Nova quickly spots compliance gaps, engagement dips and skills shortfalls across every team the moment they appear, then explains what changed and suggests what to do next.",
            "media": {
              "assetRole": "placeholder.neutral",
              "placeholderLabel": "Product screenshot"
            }
          },
          {
            "tab": "Creator",
            "text": "Turn policies, slide decks and rough notes into polished, interactive courses in minutes, complete with quizzes, summaries and translations ready for every team in the business.",
            "media": {
              "assetRole": "placeholder.neutral",
              "placeholderLabel": "Product screenshot"
            }
          },
          {
            "tab": "Coach",
            "text": "Nova checks in after each lesson, asks what landed and suggests one small next step, so new habits keep building long after the session ends for everyone.",
            "media": {
              "assetRole": "placeholder.neutral",
              "placeholderLabel": "Product screenshot"
            }
          },
          {
            "tab": "Admin",
            "text": "Let Nova build audiences, schedule reminders, tidy enrolments and prepare reports in the background, so your team can spend far more time with people and far less time on routine setup tasks.",
            "media": {
              "assetRole": "placeholder.neutral",
              "placeholderLabel": "Product screenshot"
            }
          },
          {
            "tab": "Assistant",
            "text": "Anyone can ask Nova a question in the flow of work and get a clear answer from your own content, with links to dig deeper.",
            "media": {
              "assetRole": "placeholder.neutral",
              "placeholderLabel": "Product screenshot"
            }
          }
        ],
        "paneMedia": {
          "assetRole": "placeholder.neutral",
          "placeholderLabel": "Product screenshot"
        }
      },
      "motion": {
        "pattern": "tabs.fadeOutIn",
        "reducedMotionFallback": "instant-toggle"
