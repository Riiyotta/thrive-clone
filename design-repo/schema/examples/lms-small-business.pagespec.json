    {
      "section": "product.wow-bento",
      "content": {
        "variant": "cards",
        "title": "The training platform that grows with your small business",
        "quote": {
          "quote": "“A genuinely clever platform that our people actually enjoy using every day. Setup took days, not months, and every single update makes it even better again for all of us.”",
          "name": "Jordan Ellis",
          "role": "People Development Manager,",
          "org": "Northwind Trust",
          "avatar": {
            "assetRole": "placeholder.neutral"
          }
        },
        "cards": [
          {
            "media": {
              "assetRole": "placeholder.neutral",
              "placeholderLabel": "Product visual"
            },
            "lead": "Smooth onboarding.",
            "text": "Get every new starter contributing from day one with guided",
            "link": "onboarding journeys.",
            "after": "Nimbus Go replaces scattered induction packs with a system that small teams can actually run."
          },
          {
            "media": {
              "assetRole": "placeholder.neutral",
              "placeholderLabel": "Product visual"
            },
            "lead": "Compliance training.",
            "text": "Assign, track and evidence mandatory training for every employee automatically, then see it all in one place with",
            "link": "live reporting.",
            "after": "No spreadsheets, no chasing, no stress."
          },
          {
            "media": {
              "assetRole": "placeholder.neutral",
              "placeholderLabel": "Product visual"
            },
            "lead": "Knowledge sharing.",
            "text": "Stop know-how walking out the door. Capture, organise and share what your team knows in one place, with",
            "link": "Nova",
            "after": "on hand to surface it the moment someone needs it."
          },
          {
            "media": {
              "assetRole": "placeholder.neutral",
              "placeholderLabel": "Product visual"
            },
            "lead": "Skills growth.",
            "text": "Spot gaps, build skills and develop your people, whether or not you have a dedicated learning team. Our",
            "link": "skills toolkit",
            "after": "makes it simple to follow progress as it happens."
          },
          {
            "media": {
              "assetRole": "placeholder.neutral",
              "placeholderLabel": "Product visual"
            },
            "lead": "Team updates.",
            "text": "No scattered group chats or email chains.",
            "link": "Chat",
            "after": ", share news and connect your whole team in Spaces, keeping updates and company news all in one place."
          }
        ],
        "ctaLabel": "See Nimbus Go in action"
      },
      "motion": {
        "pattern": "scroll.revealOnce",
        "reducedMotionFallback": "instant-final-state"
      }
