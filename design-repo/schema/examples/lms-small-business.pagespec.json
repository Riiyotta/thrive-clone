    {
      "section": "hero.wow-content",
      "content": {
        "variant": "small-business",
        "eyebrow": "Nimbus Go",
        "title": "The best platform for small teams",
        "paragraph": "Nimbus Go is the friendly learning platform built for small businesses of 10 to 500 people — big-company features, without the big-company price tag.\n\nOnboarding, compliance courses and skills growth, made simple. 900+ ready-made courses, mentoring and Nova, our AI assistant, all included at no extra cost.",
        "quote": {
          "quote": "\"I would happily recommend Nimbus to other organisations. It's a brilliant platform. It has that “pick up and go” feel for people who are very busy at work, but need to build content quickly. Ultimately it's a really great experience for every learner.\"",
          "name": "Jordan Ellis",
          "role": "Learning Development and Innovation Lead,",
          "org": "Northwind Community Trust",
          "avatar": {
            "assetRole": "placeholder.neutral"
          }
        },
        "buttonLabel": "See Nimbus in action →",
        "visual": {
          "assetRole": "placeholder.neutral",
          "placeholderLabel": "Product screenshot"
        }
      },
      "motion": {
        "pattern": "none",
        "reducedMotionFallback": "none"
      }
