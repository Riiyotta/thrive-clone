        "headingLine1": "Meet the AI helper that",
        "headingLine2": "knows your",
        "headingEmphasis": "people",
        "assistantName": "Nova",
        "introLines": [
          "Nova is an assistant built into every corner of the platform, ready to help.",
          "It learns from your own content, so every answer sounds like your team wrote it."
        ],
        "ctaLabel": "Meet Nova →",
        "tabs": [
          {
            "tab": "Coach",
            "highlight": "A coach in every pocket.",
            "subdued": "Nova checks in after each session, asks what stuck, and suggests one small next step so new habits keep building long after the training day ends.",
            "video": {
              "assetRole": "placeholder.neutral",
              "placeholderLabel": "Product video 1:1"
            }
          },
          {
            "tab": "Creator",
            "highlight": "Draft a course in minutes.",
            "subdued": "Drop in a policy, a slide deck or a rough outline and Nova shapes it into a short, friendly course with quizzes, ready for you to tweak, approve and publish.",
            "video": {
              "assetRole": "placeholder.neutral",
              "placeholderLabel": "Product video 1:1"
            }
          },
          {
            "tab": "Analyst",
            "highlight": "Ask your data anything, plainly.",
            "subdued": "Type a question about completions, skills or engagement and Nova answers with a clear chart and a short summary you can share with leaders.",
            "video": {
              "assetRole": "placeholder.neutral",
              "placeholderLabel": "Product video 1:1"
            }
          },
          {
            "tab": "Admin",
            "highlight": "Let routine setup run itself.",
            "subdued": "Nova builds audiences, schedules reminders and tidies up enrolments in the background, so your team spends less time on admin and more on people.",
            "video": {
              "assetRole": "placeholder.neutral",
              "placeholderLabel": "Product video 1:1"
            }
          },
          {
            "tab": "Assistant",
            "highlight": "Answers right when they matter.",
            "subdued": "Anyone can ask Nova a question in the flow of work and get a helpful answer pulled from your own content, with links to dig deeper.",
            "video": {
              "assetRole": "placeholder.neutral",
              "placeholderLabel": "Product video 1:1"
            }
          }
